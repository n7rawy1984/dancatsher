# Set only after the client confirms the official public domain.
# NEXT_PUBLIC_SITE_URL=https://confirmed-domain.example
# Enable only for the approved production build; previews remain noindex by default.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Public values are embedded at build time. Rebuild after changing them.
# Never put mail-provider secrets in NEXT_PUBLIC_* variables or data/company.ts.
# Optional local LAN development only: comma-separated trusted hostnames/IPs (no scheme).
# NEXT_DEV_ALLOWED_ORIGINS=your-local-hostname
